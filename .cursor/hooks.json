{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "command": "python .cursor/hooks/session-brief.py",
        "timeout": 30
      }
    ],
    "sessionEnd": [
      {
        "command": "python .cursor/hooks/record-usage.py",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "python .cursor/hooks/guard-destructive.py",
        "timeout": 10
      },
      {
        "command": "python .cursor/hooks/guard-app-launch.py",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "command": "python .cursor/hooks/gate.py",
        "timeout": 120,
        "loop_limit": 2
      }
    ],
    "subagentStop": [
      {
        "command": "python .cursor/hooks/gate.py",
        "timeout": 120,
        "loop_limit": 2
      }
    ]
  }
}

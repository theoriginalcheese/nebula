# Python
__pycache__/
*.pyc

# Build output
build/
dist/

# Logs
logs/
*.log

# Machine-specific config & data (per-machine paths/prefs; regenerated on first run)
config.json
games.json
steam_appid_cache.json

# graphify knowledge graph (regenerate locally; not source)
graphify-out/
graphify-cluster.log
graphify-extract.log

# Misc runtime/output files
obs_auto_record_log.txt
obs_websocket.log
SORTED NON-GAMES.txt

# Unrelated stray file (RoboCopy shell-extension reg tweak, not part of Nebula)
Windows Registry Editor Version 5.0.reg
.nebula/

# Screenshot captures from tools/shoot.py (ephemeral verification output)
shots/
app_paths.json
icons/

# Runtime session log — written on every run, so tracking it dirtied the tree
# on each launch and published play history to a public repo.
sessions.jsonl

# Transient gate verdict, written by .cursor/hooks/gate.py on every stop.
.cursor/handoff/.gate-state.json

# Toast motion/capture scratch — PNG frames and diffs from tools/capture_* and demos;
# the scripts under tools/ stay tracked, only their output dirs are ephemeral.
_alien_toast_scan/
tools/_toast_demo/
tools/_toast_demo_local_cmp/
tools/_toast_demo_spike_capsule/

# Parallel-agent worktrees — isolated checkouts, not project source.
.claude/worktrees/

# Offloader queue + worker checkpoint — per-machine, regenerated / retried locally.
# Never upload the queue: Save this machine would otherwise ship it between PCs.
offload_queue.json
offload_state.json

# On-demand Clips catalog — per-machine index + re-evictable cache/posters.
# Never commit NAS library listings or fetched video bytes.
clip_index.json
clip_cache/
clip_posters/
